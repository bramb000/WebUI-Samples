{
  "name": "bramha-personal-portfolio",
  "homepage": "https://bramb000.github.io/bramha-personal-portfolio/",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-seo-assets.mjs && vue-tsc -b && vite build && node scripts/prerender.mjs && node scripts/generate-llm-mirror.mjs && node scripts/generate-sitemap.mjs && node scripts/seo-smoke-test.mjs",
    "build:app": "vue-tsc -b && vite build",
    "seo:prerender": "node scripts/prerender.mjs",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "predeploy": "npm run build && npm run build-storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o build/storybook",
    "assets:inventory": "node scripts/asset-inventory.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "assets:optimize:write": "node scripts/optimize-assets.mjs --write",
    "assets:migrate-webp": "node scripts/migrate-imports-to-webp.mjs",
    "logo:prepare": "node scripts/prepare-logo-gif.mjs"
  },
  "dependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@unhead/vue": "^3.1.1",
    "lottie-web": "^5.13.0",
    "lucide-vue-next": "^0.575.0",
    "posthog-js": "^1.356.2",
    "three": "^0.184.0",
    "vue": "^3.5.13",
    "vue-router": "^5.0.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@storybook/addon-a11y": "^10.2.8",
    "@storybook/addon-docs": "^10.2.8",
    "@storybook/addon-onboarding": "^10.2.8",
    "@storybook/addon-vitest": "^10.2.8",
    "@storybook/vue3-vite": "^10.2.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "playwright": "^1.58.2",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "storybook": "^10.2.8",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.6.2",
    "vite": "^6.0.5",
    "vitest": "^4.0.18",
    "vue-tsc": "^2.2.0"
  }
